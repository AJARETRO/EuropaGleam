diff --git a/src/Platform.c b/src/Platform.c
index 9782e006..eec5842f 100644
--- a/src/Platform.c
+++ b/src/Platform.c
@@ -3,6 +3,9 @@
 #if defined(__vita__)
 #include <pthread.h>
 #endif
+#if defined(__linux__)
+#include <sys/resource.h>
+#endif
 
 // The maximum amount of time before observing an interrupt
 // in PltSleepMsInterruptible().
@@ -79,6 +82,11 @@ void* ThreadProc(void* context) {
     setThreadNameWin32(ctx->name);
 #elif defined(__linux__) || defined(__FreeBSD__)
     pthread_setname_np(pthread_self(), ctx->name);
+#if defined(__linux__)
+    if (ctx->name != NULL && (strcmp(ctx->name, "AudioRecv") == 0 || strcmp(ctx->name, "AudioDec") == 0)) {
+        setpriority(PRIO_PROCESS, 0, -19);
+    }
+#endif
 #elif defined(LC_DARWIN)
     pthread_setname_np(ctx->name);
 #endif
diff --git a/src/PlatformSockets.c b/src/PlatformSockets.c
index 56f9b9c3..aa19d48d 100644
--- a/src/PlatformSockets.c
+++ b/src/PlatformSockets.c
@@ -284,6 +284,17 @@ static void setSocketQos(SOCKET s, int socketQosType) {
     if (setsockopt(s, SOL_SOCKET, SO_PRIORITY, (char*)&value, sizeof(value)) < 0) {
         Limelog("setsockopt(SO_PRIORITY, %d) failed: %d\n", value, (int)LastSocketError());
     }
+
+#if defined(IP_TOS)
+    if (socketQosType == SOCK_QOS_TYPE_AUDIO) {
+        // DSCP 46 (Expedited Forwarding / WMM Voice) = 46 << 2 = 0xB8
+        int tos = 0xB8;
+        setsockopt(s, IPPROTO_IP, IP_TOS, (char*)&tos, sizeof(tos));
+#if defined(IPV6_TCLASS)
+        setsockopt(s, IPPROTO_IPV6, IPV6_TCLASS, (char*)&tos, sizeof(tos));
+#endif
+    }
+#endif
 #endif
 }
